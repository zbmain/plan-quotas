# 管理后台密码。首次部署后建议立即修改。
ADMIN_PASSWORD=admin

# 本地直接运行时使用的持久化目录与前端静态资源目录。
# Docker Compose 会固定使用容器内路径 /app/data 和 /app/frontend/dist。
DATA_DIR=./data
STATIC_DIR=./frontend/dist

# 直接通过 HTTP 使用时保持 false；HTTPS 反向代理下设置为 true。
COOKIE_SECURE=false

# 允许访问的 Host，使用逗号分隔。部署到自定义域名时请加入域名。
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 站点的外部 HTTPS 地址，可留空；配置后用于验证浏览器请求来源。
PUBLIC_ORIGIN=

# 端口映射。默认仅绑定本机；局域网访问需将 BIND_HOST 改为 0.0.0.0。
PORT=8000
BIND_HOST=127.0.0.1
